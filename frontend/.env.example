# Copy to `.env` and fill in your deployed contract id.
# Network: TESTNET (default) or PUBLIC
VITE_NETWORK=TESTNET

# The Carbon Registry contract id (starts with C…), from `stellar contract deploy`.
VITE_REGISTRY_CONTRACT_ID=

# Optional overrides (sensible testnet defaults are used if unset):
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
